# Plant.id API key (by Kindwise) — sign up at https://www.kindwise.com/plant-id, then copy the key from the API tab.
PLANTID_API_KEY=your-plant-id-api-key-here

# Shared password every player types on the login screen to enter the game.
SPROUTQUEST_PASSWORD=change-me

# Secret used to sign Flask session cookies. Generate a strong random value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional overrides:
# CONFIDENCE_THRESHOLD=0.95                              # min species confidence to accept a find (0.95 is strict)
# BONUS_PLANTS={"Asclepias syriaca":50,"trillium":30}   # make certain plants score higher
# PLANTID_API_URL=https://api.plant.id/v3/identification
# DATABASE_PATH=sproutquest.db
# PORT=5000
# FLASK_DEBUG=1
